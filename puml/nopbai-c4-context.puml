@startuml nopbai-c4-context
title C4 Context (L1) — Nopbai Personal Loan Platform
caption People, system-in-focus, and external systems only
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

actor "Customer\nExisting salaried customer" as customer
rectangle "Nopbai Personal Loan Platform\nSystem in focus\nMobile application and automated decisioning" as platform #E8F1FB
rectangle "Credit Scoring System\nExternal system\nReturns Credit Score" as scoring #F5F5F5
rectangle "ESB Integration Layer\nExternal system\nRoutes accounting and disbursement" as esb #F5F5F5
rectangle "Core Banking\nExternal system\nValidates account and records posting" as core #F5F5F5

customer --> platform : submits Loan Application
customer --> platform : reviews Loan Offer and accepts contract
platform --> scoring : requests Credit Score
platform --> esb : sends approved accounting and disbursement request
esb --> core : routes validation, posting, and confirmation

legend bottom
  C4 Context L1: no internal containers, databases, buses, or protocols.
  External systems are exactly the I-3 names from list.md.
endlegend
@enduml
