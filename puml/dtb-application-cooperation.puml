@startuml dtb-application-cooperation
!include <archimate/Archimate>
title Application Cooperation — Daily VND credit transfer (DTB)
caption VCB Architecture Modeling Language — Daily Transaction Banking trainee sample
left to right direction

' === External Actor ===
Business_Actor(customer, "Customer")

' === Channel components ===
Application_Component(shell, "Application Component APP.CMP.01\nAppShell")
Application_Component(txMfe, "Application Component APP.CMP.02\nTransferMFE")
Application_Component(histMfe, "Application Component APP.CMP.03\nHistoryMFE")
Application_Component(bff, "Application Component APP.CMP.04\nChannelBFF")

' === Backend components ===
Application_Component(orch, "Application Component APP.CMP.05\nPaymentOrchestration")
Application_Component(limitSvc, "Application Component APP.CMP.06\nLimitService")
Application_Component(histSvc, "Application Component APP.CMP.07\nHistoryService")
Application_Component(coreAd, "Application Component APP.CMP.08\nCoreAdapter")
Application_Component(napasAd, "Application Component APP.CMP.09\nNAPASAdapter")

' === External systems ===
Application_Component(core, "Application Component APP.CMP.10\nCoreBanking (external)")
Application_Component(napas, "Application Component APP.CMP.11\nNAPASSwitch (external)")

' === Serving: Customer to Channel ===
Rel_Serving(shell, customer, "serving: navigate")

' === Serving: AppShell hosts MFEs ===
Rel_Serving(shell, txMfe, "serving: host remote")
Rel_Serving(shell, histMfe, "serving: host remote")

' === Serving: MFEs to BFF ===
Rel_Serving(bff, txMfe, "serving: command")
Rel_Serving(bff, histMfe, "serving: query")

' === Serving: BFF to backend ===
Rel_Serving(orch, bff, "serving: initiate transfer")
Rel_Serving(histSvc, bff, "serving: list detail")

' === Serving: Orchestration to domain services ===
Rel_Serving(limitSvc, orch, "serving: reserve release")
Rel_Serving(histSvc, orch, "serving: project status")
Rel_Serving(coreAd, orch, "serving: post or reverse")
Rel_Serving(napasAd, orch, "serving: interbank only")

' === Serving: Adapters to external ===
Rel_Serving(core, coreAd, "serving: debit credit reverse")
Rel_Serving(napas, napasAd, "serving: credit instruction 30s")

legend bottom
  Application Cooperation — ArchiMate Serving relationships only.
  Write path: TransferMFE → BFF → Orchestration → LimitService + CoreAdapter + NAPASAdapter.
  Read path: HistoryMFE → BFF → HistoryService. No NAPAS on query.
  Not a single Channel box — four channel containers. Same strings as C4 L2.
  Teaching diagram — redraw in Archi for the dossier.
endlegend
@enduml
