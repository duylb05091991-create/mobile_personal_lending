@startuml nopbai-application-architecture
!include <archimate/Archimate>
title Application Cooperation — Nopbai Mobile Personal Loan
left to right direction

Business_Actor(customer, "Business Actor\nCustomer")
Application_Component(mobileApp, "Application Component\nMobile App")
Application_Component(loanService, "Application Component\nLoan Application Service")
Application_Component(scoreAdapter, "Application Component\nCredit Scoring Adapter")
Application_Component(decisionEngine, "Application Component\nDecision Engine")
Application_Component(policyEngine, "Application Component\nPolicy Engine")
Application_Component(accountValidation, "Application Component\nAccount Validation Service")
Application_Component(disbursementAdapter, "Application Component\nDisbursement Adapter")
Application_Component(decisionStore, "Application Component\nDecision Store")
Application_Component(auditLog, "Application Component\nAudit Log")
Application_Component(creditScoring, "Application Component\nCredit Scoring System (external)")
Application_Component(esb, "Application Component\nESB Integration Layer (external)")
Application_Component(coreBanking, "Application Component\nCore Banking (external)")

Rel_Serving(mobileApp, customer, "serving")
Rel_Serving(loanService, mobileApp, "serving: submit")
Rel_Serving(decisionEngine, loanService, "serving: decide")
Rel_Serving(scoreAdapter, decisionEngine, "serving: score")
Rel_Serving(creditScoring, scoreAdapter, "serving: external score")
Rel_Serving(policyEngine, decisionEngine, "serving: policy")
Rel_Serving(decisionEngine, mobileApp, "serving: offer and outcome")
Rel_Serving(decisionStore, decisionEngine, "serving: persist decision")
Rel_Serving(auditLog, decisionEngine, "serving: audit evidence")
Rel_Serving(accountValidation, decisionEngine, "serving: validate account")
Rel_Serving(disbursementAdapter, accountValidation, "serving: approved disbursement")
Rel_Serving(esb, disbursementAdapter, "serving: route posting")
Rel_Serving(coreBanking, esb, "serving: validate and post")
@enduml
