@startuml nopbai-organization-product
!include <archimate/Archimate>
title Organization and Product — Nopbai Mobile Personal Loan
top to bottom direction

Business_Actor(customer, "Business Actor\nCustomer")
Business_Actor(operations, "Business Actor\nLoan Operations Specialist")
Business_Role(applicant, "Business Role\nLoan Applicant")
Business_Role(exceptionReviewer, "Business Role\nException Reviewer")
Business_Interface(product, "Product\nNopbai Mobile Personal Loan")
Business_Service(intake, "Business Service\nLoan application intake")
Business_Service(decision, "Business Service\nOffer calculation and decisioning")
Business_Service(disbursement, "Business Service\nAccount validation and disbursement")
Business_Service(traceability, "Business Service\nDecision traceability")
Business_Object(application, "Business Object\nLoan Application")
Business_Object(offer, "Business Object\nLoan Offer")
Business_Object(agreement, "Business Object\nNopbai Personal Loan Agreement")
Business_Object(record, "Business Object\nDecision Record")

Rel_Assignment(customer, applicant, "assignment")
Rel_Assignment(operations, exceptionReviewer, "assignment")
Rel_Composition(product, intake, "composition")
Rel_Composition(product, decision, "composition")
Rel_Composition(product, disbursement, "composition")
Rel_Composition(product, traceability, "composition")
Rel_Serving(intake, applicant, "serving")
Rel_Serving(decision, applicant, "serving")
Rel_Serving(disbursement, applicant, "serving")
Rel_Serving(traceability, exceptionReviewer, "serving")
Rel_Association(application, product, "association")
Rel_Association(offer, product, "association")
Rel_Association(agreement, product, "association")
Rel_Association(record, product, "association")
@enduml
