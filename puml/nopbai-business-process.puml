@startuml nopbai-business-process
!include <archimate/Archimate>
title Business Process — Nopbai Mobile Personal Loan
top to bottom direction

Business_Actor(customer, "Business Actor\nCustomer")
Business_Role(applicant, "Business Role\nLoan Applicant")
Business_Process(submit, "Business Process\nSubmit Loan Application")
Business_Process(validate, "Business Process\nValidate customer and request")
Business_Process(score, "Business Process\nRetrieve Credit Score")
Business_Process(calculate, "Business Process\nCalculate amount and rate")
Business_Process(offer, "Business Process\nPresent Loan Offer")
Business_Process(decide, "Business Process\nApply automated decision")
Business_Process(account, "Business Process\nValidate payment account")
Business_Process(disburse, "Business Process\nDisburse and post accounting")
Business_Process(audit, "Business Process\nRecord decision evidence")
Business_Object(application, "Business Object\nLoan Application")
Business_Object(scoreObject, "Business Object\nCredit Score")
Business_Object(offerObject, "Business Object\nLoan Offer")
Business_Object(record, "Business Object\nDecision Record")

Rel_Assignment(customer, applicant, "assignment")
Rel_Assignment(applicant, submit, "assignment")
Rel_Triggering(submit, validate, "triggering")
Rel_Triggering(validate, score, "triggering")
Rel_Triggering(score, calculate, "triggering")
Rel_Triggering(calculate, offer, "triggering")
Rel_Triggering(offer, decide, "triggering")
Rel_Triggering(decide, account, "approved")
Rel_Triggering(account, disburse, "valid account")
Rel_Triggering(disburse, audit, "triggering")
Rel_Access(submit, application, "create")
Rel_Access(score, scoreObject, "read")
Rel_Access(offer, offerObject, "create")
Rel_Access(decide, record, "write")
@enduml
