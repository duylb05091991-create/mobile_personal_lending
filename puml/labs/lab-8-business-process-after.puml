@startuml lab-8-business-process-after
!include <archimate/Archimate>
title Lab 8 Business Process — Nopbai Mobile Personal Loan
top to bottom direction
Business_Actor(customer, "Business Actor\nCustomer")
Business_Process(submit, "Business Process\nSubmit Loan Application")
Business_Process(validate, "Business Process\nValidate application")
Business_Process(score, "Business Process\nRetrieve Credit Score")
Business_Process(offer, "Business Process\nCalculate and present Loan Offer")
Business_Process(accept, "Business Process\nAccept agreement")
Business_Process(account, "Business Process\nValidate payment account")
Business_Process(disburse, "Business Process\nDisburse and post")
Business_Process(audit, "Business Process\nRecord evidence")
Motivation_Constraint(con1, "CON.1\nAmount cap")
Motivation_Constraint(con3, "CON.3\nScoring timeout")
Motivation_Constraint(con4, "CON.4\nApproval and validation before posting")
Rel_Assignment(customer, submit, "assignment")
Rel_Triggering_Down(submit, validate, "triggering")
Rel_Triggering_Down(validate, score, "triggering")
Rel_Triggering_Down(score, offer, "triggering")
Rel_Triggering_Down(offer, accept, "triggering")
Rel_Triggering_Down(accept, account, "triggering")
Rel_Triggering_Down(account, disburse, "triggering")
Rel_Triggering_Down(disburse, audit, "triggering")
Rel_Association_Down(con1, offer, "constraint")
Rel_Association_Down(con3, score, "constraint")
Rel_Association_Down(con4, account, "constraint")
@enduml
