@startuml lab-5-activity
start
:Customer submits Loan Application through Mobile App;
:Loan Application Service validates application;
if (Eligible segment? CON.2) then (yes)
  :Decision Engine requests Credit Score;
  if (Score returned? CON.3) then (yes)
    :Policy Engine calculates amount and rate;
    if (Within cap? CON.1) then (yes)
      :Decision Engine creates Loan Offer;
      :Customer accepts Nopbai Personal Loan Agreement;
      if (Account valid? CON.4) then (yes)
        :Disbursement Adapter sends request through ESB Integration Layer;
        if (Core Banking confirms?) then (yes)
          :Record Disbursed in Decision Store and Audit Log;
        else (no)
          :Record Failed and reconcile;
        endif
      else (no)
        :Record Failed; no disbursement;
      endif
    else (no)
      :Record Rejected;
    endif
  else (no)
    :Record Failed; no approval;
  endif
else (no)
  :Record Rejected;
endif
stop
@enduml
