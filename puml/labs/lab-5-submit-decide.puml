@startuml lab-5-submit-decide
actor Customer
participant "Mobile App" as MobileApp
participant "Loan Application Service" as LoanApplicationService
participant "Decision Engine" as DecisionEngine
participant "Credit Scoring Adapter" as CreditScoringAdapter
participant "Policy Engine" as PolicyEngine
database "Decision Store" as DecisionStore
collections "Audit Log" as AuditLog

Customer -> MobileApp: submit Loan Application
MobileApp -> LoanApplicationService: create and validate
LoanApplicationService -> DecisionEngine: start decision
DecisionEngine -> CreditScoringAdapter: get Credit Score
alt CON.3 scoring timeout
  CreditScoringAdapter --> DecisionEngine: timeout
  DecisionEngine -> DecisionStore: record Failed
  DecisionEngine -> AuditLog: record exception
else score returned
  CreditScoringAdapter --> DecisionEngine: Credit Score
  DecisionEngine -> PolicyEngine: calculate amount and rate
  alt CON.1 amount exceeds cap
    PolicyEngine --> DecisionEngine: reject
    DecisionEngine -> DecisionStore: record Rejected
  else policy-compliant
    PolicyEngine --> DecisionEngine: Loan Offer
    DecisionEngine -> DecisionStore: persist Decision Record
    DecisionEngine -> AuditLog: record evidence
    DecisionEngine --> MobileApp: present Loan Offer
  end
end
@enduml
