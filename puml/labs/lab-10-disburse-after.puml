@startuml lab-10-disburse-after
title Lab 10 UML Sequence — Disburse Approved Loan Application
actor Customer
participant "Mobile App" as MobileApp
participant "Account Validation Service" as AccountValidationService
participant "Disbursement Adapter" as DisbursementAdapter
participant "ESB Integration Layer" as Esb
participant "Core Banking" as CoreBanking
database "Decision Store" as DecisionStore
collections "Audit Log" as AuditLog

Customer -> MobileApp: accept Nopbai Personal Loan Agreement
MobileApp -> AccountValidationService: validate payment account
alt CON.4 account validation fails
  AccountValidationService --> MobileApp: Failed
  AccountValidationService -> DecisionStore: record Failed
  AccountValidationService -> AuditLog: record exception
else account valid
  AccountValidationService -> DisbursementAdapter: authorize approved flow
  DisbursementAdapter -> Esb: async Submit Disbursement and Accounting Request
  Esb -> CoreBanking: async validate and post
  alt CON.4 posting confirmation fails
    CoreBanking --> Esb: failure
    Esb --> DisbursementAdapter: Failed
    DisbursementAdapter -> DecisionStore: record Failed and idempotency key
    DisbursementAdapter -> AuditLog: record reconciliation event
  else confirmed
    CoreBanking --> Esb: confirmed
    Esb --> DisbursementAdapter: Disbursed
    DisbursementAdapter --> MobileApp: Disbursed
  end
end
@enduml
