@startuml nopbai-motivation
!include <archimate/Archimate>
title Motivation — Nopbai Mobile Personal Loan
left to right direction

Motivation_Stakeholder(customer, "Stakeholder\nCustomer")
Motivation_Stakeholder(owner, "Stakeholder\nBusiness Owner")
Motivation_Stakeholder(risk, "Stakeholder\nRisk and Compliance")
Motivation_Driver(driverFast, "Driver\nNeed for fast mobile lending")
Motivation_Driver(driverControl, "Driver\nNeed for controlled personalized lending")
Motivation_Driver(driverEvidence, "Driver\nNeed for secure accounting evidence")
Motivation_Goal(goalJourney, "Goal\nProvide mobile-first unsecured lending")
Motivation_Goal(goalDecision, "Goal\nAutomate policy-controlled decisioning")
Motivation_Goal(goalDisburse, "Goal\nDisburse approved loans reliably")
Motivation_Goal(goalAudit, "Goal\nPreserve explainable evidence")
Motivation_Outcome(outcomeTime, "Outcome\nASSUMPTION: decision P95 <= 30 seconds")
Motivation_Outcome(outcomeOffer, "Outcome\nPolicy-compliant amount and rate")
Motivation_Outcome(outcomeFunds, "Outcome\nDisbursement after approval and validation")
Motivation_Outcome(outcomeAudit, "Outcome\nAuditable decision and transaction evidence")
Motivation_Requirement(fr01, "Requirement\nFR-01 Mobile App submission")
Motivation_Requirement(fr03, "Requirement\nFR-03 Credit Score retrieval")
Motivation_Requirement(fr07, "Requirement\nFR-07 Auto decisioning")
Motivation_Requirement(fr09, "Requirement\nFR-09 Immediate disbursement")
Motivation_Requirement(fr10, "Requirement\nFR-10 Accounting through ESB")
Motivation_Requirement(fr11, "Requirement\nFR-11 Decision traceability")
Motivation_Constraint(con1, "Constraint CON.1\nAmount <= 100,000,000 VND")
Motivation_Constraint(con2, "Constraint CON.2\nExisting salaried customers aged 22-35")
Motivation_Constraint(con3, "Constraint CON.3\nNear-real-time scoring")
Motivation_Constraint(con4, "Constraint CON.4\nApproval and validation before posting")
Motivation_Constraint(con5, "Constraint CON.5\nProtected and auditable evidence")

Rel_Association(customer, driverFast, "association")
Rel_Association(owner, driverControl, "association")
Rel_Association(risk, driverEvidence, "association")
Rel_Influence(driverFast, goalJourney, "influence")
Rel_Influence(driverControl, goalDecision, "influence")
Rel_Influence(driverEvidence, goalAudit, "influence")
Rel_Association(goalJourney, outcomeTime, "association")
Rel_Association(goalDecision, outcomeOffer, "association")
Rel_Association(goalDisburse, outcomeFunds, "association")
Rel_Association(goalAudit, outcomeAudit, "association")
Rel_Realization(goalJourney, fr01, "realization")
Rel_Realization(goalDecision, fr03, "realization")
Rel_Realization(goalDecision, fr07, "realization")
Rel_Realization(goalDisburse, fr09, "realization")
Rel_Realization(goalDisburse, fr10, "realization")
Rel_Realization(goalAudit, fr11, "realization")
Rel_Association(con1, goalDecision, "constraint")
Rel_Association(con2, goalJourney, "constraint")
Rel_Association(con3, goalDecision, "constraint")
Rel_Association(con4, goalDisburse, "constraint")
Rel_Association(con5, goalAudit, "constraint")
@enduml
