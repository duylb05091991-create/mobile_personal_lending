@startuml nopbai-strategy
!include <archimate/Archimate>
title Strategy — Nopbai Mobile Personal Loan
top to bottom direction

Motivation_Outcome(outcomeTime, "Outcome\nASSUMPTION: decision P95 <= 30 seconds")
Motivation_Outcome(outcomeOffer, "Outcome\nPolicy-compliant amount and rate")
Motivation_Outcome(outcomeFunds, "Outcome\nDisbursement after approval and validation")
Motivation_Outcome(outcomeAudit, "Outcome\nAuditable decision and transaction evidence")
Strategy_Capability(capIntake, "Capability\nLoan application intake")
Strategy_Capability(capScore, "Capability\nEligibility and scoring")
Strategy_Capability(capPolicy, "Capability\nPolicy and offer calculation")
Strategy_Capability(capDecision, "Capability\nAutomated decisioning")
Strategy_Capability(capDisburse, "Capability\nAccount validation and disbursement")
Strategy_Capability(capEvidence, "Capability\nDecision traceability and audit")

Rel_Realization(outcomeTime, capIntake, "realization")
Rel_Realization(outcomeTime, capScore, "realization")
Rel_Realization(outcomeOffer, capPolicy, "realization")
Rel_Realization(outcomeOffer, capDecision, "realization")
Rel_Realization(outcomeFunds, capDisburse, "realization")
Rel_Realization(outcomeAudit, capEvidence, "realization")
@enduml
